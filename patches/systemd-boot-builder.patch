+        # nixos-build-helpers: bootctl compares the installed boot loader with the one of its own
+        # systemd package. If that package already updated it (or found it current), it would
+        # only find it current again: don't start it (~30 ms). Recorded on the ESP itself, so a
+        # new or restored ESP gets the update.
+        marker = EFI_SYS_MOUNT_POINT / "loader" / ".nixos-bootctl-update"
+        try:
+            up_to_date = marker.read_text() == f"{SYSTEMD}\n"
+        except OSError:
+            up_to_date = False
+        if not up_to_date:
+            reply = bootctl_varlink_call("io.systemd.BootControl.Install", params)
+
+            error = reply.get("error")
+            if error is not None:
+                error_params = reply.get("parameters") or {}
+                if (
+                    error == "io.systemd.System"
+                    and error_params.get("errno") == errno.ESTALE
+                ):
+                    # Same or newer boot loader version already in place.
+                    pass
+                else:
+                    raise RuntimeError(
+                        f"bootctl update failed: {error} {json.dumps(error_params)}"
+                    )
+            marker.parent.mkdir(parents=True, exist_ok=True)
+            tmp = marker.with_suffix(".tmp")
+            tmp.write_text(f"{SYSTEMD}\n")
+            os.rename(tmp, marker)
 
