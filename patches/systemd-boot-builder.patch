+def check_mountpoints() -> None:
+    # nixos-build-helpers: what check-mountpoints does (`findmnt <path>` for both), from the
+    # mount table, without starting bash and findmnt.
+    with open("/proc/self/mountinfo") as f:
+        # The fifth field, with spaces etc. escaped as octal.
+        targets = {
+            re.sub(r"\\([0-7]{3})", lambda m: chr(int(m.group(1), 8)), line.split()[4])
+            for line in f
+        }
+    for name, path in [
+        ("efiSysMountPoint", EFI_SYS_MOUNT_POINT),
+        ("xbootldrMountPoint", BOOT_MOUNT_POINT),
+    ]:
+        if str(path) not in targets:
+            print(
+                f"{name} = '{path}' is not a mounted partition. Is the path configured correctly?",
+                file=sys.stderr,
+            )
+            sys.exit(1)
+
