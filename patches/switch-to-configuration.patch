 /// from the scope because by the time the user-scope child runs, /etc has
 /// already been switched to the new configuration, so the caller must supply
 /// a captured reference to the pre-switch unit directory.
+/// The FragmentPath of each unit, asked for all at once. Upstream asks one unit after the other,
+/// a round trip each: ~30 ms for the ~200 active units of a desktop, the longest part of planning
+/// a switch. The replies are collected by local filters while `process` dispatches everything
+/// else (systemd's signals) as usual. A unit without an answer (an error, a timeout) is missing,
+/// and the caller asks for it alone, as upstream does.
+fn fragment_paths(
+    conn: &LocalConnection,
+    units: &HashMap<String, UnitState>,
+) -> HashMap<String, String> {
+    use dbus::{
+        arg::Variant,
+        channel::{Channel, MatchingReceiver},
+        message::{MatchRule, MessageType},
+    };
+
+    let channel: &Channel = conn.channel();
+    let mut pending: HashMap<u32, String> = HashMap::new();
+    for (unit, state) in units {
+        let Ok(msg) = Message::new_method_call(
+            &*state.proxy.destination,
+            &*state.proxy.path,
+            "org.freedesktop.DBus.Properties",
+            "Get",
+        ) else {
+            continue;
+        };
+        let msg = msg.append2("org.freedesktop.systemd1.Unit", "FragmentPath");
+        if let Ok(serial) = channel.send(msg) {
+            pending.insert(serial, unit.clone());
+        }
+    }
+
+    let replies: Rc<RefCell<HashMap<u32, Option<String>>>> = Rc::default();
+    let tokens = [MessageType::MethodReturn, MessageType::Error].map(|ty| {
+        let replies = replies.clone();
+        let mut rule = MatchRule::new();
+        rule.msg_type = Some(ty);
+        conn.start_receive(
+            rule,
+            Box::new(move |msg: Message, _: &LocalConnection| {
+                if let Some(serial) = msg.get_reply_serial() {
+                    let path = msg.read1::<Variant<String>>().ok().map(|v| v.0);
+                    replies.borrow_mut().insert(serial, path);
+                }
+                true
+            }),
+        )
+    });
+    // The timeout upstream's proxies use for each call.
+    let deadline = std::time::Instant::now() + Duration::from_secs(5);
+    while replies.borrow().len() < pending.len() {
+        let left = deadline.saturating_duration_since(std::time::Instant::now());
+        if left.is_zero() || conn.process(left).is_err() {
+            break;
+        }
+    }
+    for token in tokens {
+        conn.stop_receive(token);
+    }
+
+    let replies = replies.take();
+    pending
+        .into_iter()
+        .filter_map(|(serial, unit)| Some((unit, replies.get(&serial)?.clone()?)))
+        .collect()
+}
