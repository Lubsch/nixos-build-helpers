 /// Performs switch-to-configuration functionality for a single non-root user
+/// The binary a user manager runs, looked up by the parent for the child.
+const USER_MANAGER_EXE_ENV: &str = "__NIXOS_SWITCH_TO_CONFIGURATION_USER_MANAGER_EXE";
+
+/// Whether the old and the new version of a path have other contents. Missing in both counts as
+/// unchanged, missing in one as changed.
+fn differs(old: &Path, new: &Path) -> bool {
+    match (old.canonicalize(), new.canonicalize()) {
+        (Ok(old), Ok(new)) => !same_contents(&old, &new, 0),
+        (Err(_), Err(_)) => false,
+        _ => true,
+    }
+}
+
+/// A path the switch changes, in the old and the new toplevel: everything below
+/// /run/current-system and /etc. Other paths (home directories, /run/user, other profiles, the
+/// systemd package's own directories) don't change with the toplevel.
+fn in_toplevels(old_toplevel: &Path, toplevel: &Path, path: &Path) -> Option<(PathBuf, PathBuf)> {
+    if let Ok(rest) = path.strip_prefix("/run/current-system") {
+        Some((old_toplevel.join(rest), toplevel.join(rest)))
+    } else if let Ok(rest) = path.strip_prefix("/etc") {
+        Some((old_toplevel.join("etc").join(rest), toplevel.join("etc").join(rest)))
+    } else {
+        None
+    }
+}
+
+/// Whether anything a daemon-reload of the user manager reads changed with the toplevel: the
+/// directories of its unit search path (as the manager reports it: /etc/systemd/user, but also
+/// packages' units in /run/current-system/sw and /etc/profiles/per-user), the generators, and what
+/// systemd's own generators read (environment.d, xdg autostart). On doubt: changed.
+fn user_manager_inputs_changed(
+    systemd: &Proxy<'_, &LocalConnection>,
+    old_toplevel: &Path,
+    toplevel: &Path,
+) -> bool {
+    let (unit_path, environment) = match (systemd.unit_path(), systemd.environment()) {
+        (Ok(unit_path), Ok(environment)) => (unit_path, environment),
+        (Err(err), _) | (_, Err(err)) => {
+            log::debug!("Failed to read the user manager's search paths, reloading: {err}");
+            return true;
+        }
+    };
+    let config_dirs = environment
+        .iter()
+        .find_map(|kv| kv.strip_prefix("XDG_CONFIG_DIRS="))
+        .unwrap_or("/etc/xdg")
+        .split(':')
+        .filter(|dir| !dir.is_empty())
+        .map(|dir| Path::new(dir).join("autostart"));
+    let paths: Vec<PathBuf> = unit_path
+        .iter()
+        .map(PathBuf::from)
+        .chain(
+            [
+                "/etc/systemd/user-generators",
+                "/etc/systemd/user-environment-generators",
+                "/etc/systemd/user-preset",
+                "/etc/environment.d",
+            ]
+            .map(PathBuf::from),
+        )
+        .chain(config_dirs)
+        .collect();
+    paths.iter().any(|path| {
+        in_toplevels(old_toplevel, toplevel, path).is_some_and(|(old, new)| {
+            let changed = differs(&old, &new);
+            if changed {
+                log::debug!("{} changed, reloading the user manager", path.display());
+            }
+            changed
+        })
+    })
+}
