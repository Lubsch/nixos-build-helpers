+/// The binary the user manager of `uid` runs: the process in its unit's init.scope (cgroup v2).
+/// Read as root: the user itself may not be allowed to read /proc/<pid>/exe of its manager.
+fn user_manager_exe(uid: u32) -> Option<PathBuf> {
+    let procs = std::fs::read_to_string(format!(
+        "/sys/fs/cgroup/user.slice/user-{uid}.slice/user@{uid}.service/init.scope/cgroup.procs"
+    ))
+    .ok()?;
+    procs
+        .lines()
+        .filter_map(|pid| std::fs::read_link(format!("/proc/{pid}/exe")).ok())
+        .find(|exe| exe.ends_with("lib/systemd/systemd"))
+}
