+/// Whether two canonical paths have the same contents: files by their bytes, directories (e.g. in
+/// /etc, which is rebuilt with every change of it) entry by entry, following symlinks.
+fn same_contents(a: &Path, b: &Path, depth: usize) -> bool {
+    if a == b {
+        return true;
+    }
+    let (Ok(meta_a), Ok(meta_b)) = (std::fs::metadata(a), std::fs::metadata(b)) else {
+        return false;
+    };
+    if meta_a.is_file() && meta_b.is_file() {
+        return meta_a.len() == meta_b.len()
+            && matches!((std::fs::read(a), std::fs::read(b)), (Ok(x), Ok(y)) if x == y);
+    }
+    if !(meta_a.is_dir() && meta_b.is_dir()) || depth > 8 {
+        return false;
+    }
+    let names = |dir: &Path| -> Option<Vec<std::ffi::OsString>> {
+        let mut names = std::fs::read_dir(dir)
+            .ok()?
+            .map(|e| e.map(|e| e.file_name()))
+            .collect::<std::io::Result<Vec<_>>>()
+            .ok()?;
+        names.sort();
+        Some(names)
+    };
+    match (names(a), names(b)) {
+        (Some(names_a), Some(names_b)) if names_a == names_b => names_a.iter().all(|name| {
+            match (a.join(name).canonicalize(), b.join(name).canonicalize()) {
+                (Ok(x), Ok(y)) => same_contents(&x, &y, depth + 1),
+                _ => false,
+            }
+        }),
+        _ => false,
+    }
+}
